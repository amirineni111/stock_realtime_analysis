# Optional overrides. Copy to .env and edit as needed.
# Default DB location is %LOCALAPPDATA%\StocksRealtimeScreening\stocks_screening.sqlite3
# (kept out of OneDrive to avoid SQLite file-locking/sync conflicts).
# STOCKS_DB_PATH=C:\path\to\stocks_screening.sqlite3

# Push alerts for newly armed signals. Any of:
#   https://ntfy.sh/<your-private-topic>          (free phone push: install the ntfy app, subscribe to the topic)
#   https://discord.com/api/webhooks/...          (Discord channel webhook)
#   https://hooks.slack.com/services/...          (Slack incoming webhook)
#   any other URL                                 (receives a JSON POST)
# STOCKS_ALERT_WEBHOOK_URL=https://ntfy.sh/pick-a-long-unguessable-topic-name

# Polygon.io / Massive key for BACKTEST HISTORY only (live scans stay on yfinance).
# Free Basic plan: 2 years of minute aggregates, 5 calls/minute. On a paid plan with
# unlimited calls, set POLYGON_CALLS_PER_MINUTE=0.
# POLYGON_API_KEY=your-key
# POLYGON_CALLS_PER_MINUTE=5

# Opt-in market-regime gate: no new trades/alerts while SPY closed below its 50-day
# average. Cuts losses in weak markets; does not create an edge (see README).
# STOCKS_MARKET_REGIME_GATE=1
